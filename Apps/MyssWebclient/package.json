{
    "name": "myss-webclient",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "format": "npx prettier . --write",
        "format:check": "npx prettier . --check",
        "lint": "eslint .",
        "preview": "vite preview",
        "test:unit": "vitest --config=vitest.config.ts --project=unit",
        "test:browser": "vitest --config=vitest.config.ts --project=browser",
        "test:browser-headless": "vitest --config=vitest.config.ts --project=browser --browser.headless",
        "test:coverage": "vitest run --config=vitest.config.ts --coverage --browser.headless",
        "test:e2e": "bddgen && playwright test",
        "test:e2e:ui": "bddgen && playwright test --ui",
        "test:e2e:report": "playwright show-report",
        "generate:schema": "node --env-file=.env node_modules/.bin/openapi-ts --file openapi-ts.config.ts"
    },
    "dependencies": {
        "@bcgov/bc-sans": "2.1.2",
        "@bcgov/design-system-react-components": "0.8.1",
        "@bcgov/design-tokens": "3.2.0",
        "@formio/js": "^5.5.0",
        "@formio/react": "^6.2.1",
        "@internationalized/date": "3.12.3",
        "@tanstack/react-query": "5.90.20",
        "oidc-client-ts": "3.5.0",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "react-oidc-context": "3.3.1",
        "react-router": "8.4.0"
    },
    "devDependencies": {
        "@eslint/js": "9.39.5",
        "@hey-api/openapi-ts": "^0.99.0",
        "@playwright/test": "1.62.1",
        "@tanstack/eslint-plugin-query": "5.103.0",
        "@types/node": "25.9.7",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "5.2.0",
        "@vitest/browser-playwright": "4.0.18",
        "@vitest/coverage-v8": "4.0.18",
        "eslint": "9.39.5",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.7",
        "globals": "17.12.0",
        "playwright-bdd": "9.2.1",
        "prettier": "3.9.8",
        "typescript": "5.9.3",
        "typescript-eslint": "8.70.0",
        "vite": "7.3.6",
        "vitest-browser-react": "2.3.0"
    }
}
