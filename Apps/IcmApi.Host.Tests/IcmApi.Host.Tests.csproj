<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Icm.Api.Host.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IcmApi.Host\IcmApi.Host.csproj" />
  </ItemGroup>

  <!--
    The shared request sample is the contract between this host and MyssApi's
    provider. Linked rather than copied so there is exactly one file; if this
    path breaks, fix the path - do not duplicate it.
  -->
  <ItemGroup>
    <Content Include="..\..\Shared\contracts\bus-pass-application.sample.json"
             Link="bus-pass-application.sample.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
