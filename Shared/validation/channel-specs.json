      "problems": [
        "The channel rules of \"spouseName\" name \"worker\", which is not a channel.",
        "\"spouseName\" depends on \"hasSpouse\", which is hidden for the client channel.",
        "\"spouseName\" depends on \"hasSpouse\", which is hidden for the worker-override channel."
