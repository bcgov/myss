{
    "name": "myss-webclient",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "format": "npx prettier . --write",
        "format:check": "npx prettier . --check",
        "lint": "eslint .",
        "preview": "vite preview",
        "test:unit": "vitest --config=vitest.config.ts --project=unit",
        "test:browser": "vitest --config=vitest.config.ts --project=browser",
        "test:browser-headless": "vitest --config=vitest.config.ts --project=browser --browser.headless",
        "test:coverage": "vitest run --config=vitest.config.ts --coverage --browser.headless",
        "generate:schema": "node --env-file=.env node_modules/.bin/openapi-ts --file openapi-ts.config.ts"
    },
    "dependencies": {
        "@bcgov/bc-sans": "2.1.2",
        "@bcgov/design-system-react-components": "0.8.1",
        "@bcgov/design-tokens": "3.2.0",
        "@formio/js": "^5.5.0",
        "@formio/react": "^6.2.1",
        "@internationalized/date": "3.12.4",
        "@myss/formio": "*",
        "@myss/web-common": "*",
        "@tanstack/react-query": "5.104.4",
        "oidc-client-ts": "3.5.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-oidc-context": "3.3.1",
        "react-router": "8.4.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@hey-api/openapi-ts": "^0.99.0",
        "@tanstack/eslint-plugin-query": "5.104.4",
        "@types/node": "25.9.9",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "5.2.0",
        "@vitest/browser-playwright": "4.1.11",
        "@vitest/coverage-v8": "4.1.11",
        "eslint": "10.12.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.7",
        "globals": "17.13.0",
        "playwright": "1.62.1",
        "prettier": "3.9.10",
        "typescript": "5.9.3",
        "typescript-eslint": "8.71.2",
        "vite": "8.3.3",
        "vitest": "4.1.11",
        "vitest-browser-react": "2.3.0"
    }
}
