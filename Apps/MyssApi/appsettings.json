{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
                "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
              }
            }
          ]
        }
      }
    ]
  },
  "RequestLogging": {
    "ExcludedPaths": ["/health"]
  },
  "ForwardProxies": {
    "Enabled": false,
    "KnownProxies": []
  },
  "AllowOrigins": "*",
  "Oidc": {
    "Authority": "https://dev.loginproxy.gov.bc.ca/auth/realms/standard",
    "ClientId": "sdpr-my-ss-6498",
    "//Audience": "Expected 'aud'. Omit to default to ClientId - verified 2026-07-27 that a real IDIR token from this client carries aud == azp == the client id. Set to \"\" only for a realm that mints aud:'account', which disables audience validation and leaves the azp check as the sole guard.",
    "//RoleSource": "Realm | Client | Both. Both is the safe default until IDIM confirms whether this realm carries roles in realm_access or resource_access.",
    "RoleSource": "Both"
  },
  "Swagger": {
    "RoutePrefix": "swagger",
    "Info": {
      "Title": "My Self Serve - Reborn",
      "Description": "Provides my self serve information.",
      "License": {
        "Name": "Apache 2.0",
        "Url": "https://www.apache.org/licenses/LICENSE-2.0.html"
      }
    }
  },
  "OpenTelemetry": {
    "Enabled": false,
    "Sources": ["Myss.*"],
    "ServiceName": "MyssApi",
    "TraceConsoleExporterEnabled": false,
    "MetricsConsoleExporterEnabled": false,
    "IgnorePathPrefixes": ["/health"]
  }
}
