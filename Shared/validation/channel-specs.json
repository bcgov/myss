        { "type": "textfield", "key": "phone", "validate": { "maxLength": 30 },
          "properties": { "myssChannels": { "worker-override": { "required": true } } } }
      ] },
      "resolved": {
        "client": { "components": [
          { "type": "textfield", "key": "middleName", "properties": {}, "validate": { "required": true } },
          { "type": "textfield", "key": "phone", "validate": { "maxLength": 30 }, "properties": {} }
        ] },
        "worker-override": { "components": [
          { "type": "textfield", "key": "middleName", "properties": {} },
          { "type": "textfield", "key": "phone", "validate": { "maxLength": 30, "required": true }, "properties": {} }
        ] }
      }
