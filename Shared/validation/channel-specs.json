      ]
    },
    {
      "name": "date parts are read only from a day field",
      "spec": { "components": [
        { "type": "textfield", "key": "birthDay",
          "properties": { "myssDateParts": { "month": "birthMonth", "year": "birthYear" } } },
        { "type": "textfield", "key": "birthMonth",
          "properties": { "myssChannels": { "client": { "show": false } } } },
        { "type": "textfield", "key": "birthYear" }
      ] },
