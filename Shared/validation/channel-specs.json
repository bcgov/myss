            "components": [ { "type": "textfield", "key": "spouseName", "conditional": { "show": true, "when": "hasSpouse", "eq": "yes" } } ] },
          { "label": "Household", "key": "household",
            "properties": { "myssChannels": { "client": { "show": false } } },
            "components": [ { "type": "radio", "key": "hasSpouse" } ] }
        ] }
      ] },
      "problems": [
        "\"spouseName\" depends on \"hasSpouse\", which is hidden for the client channel."
      ]
    },
    {
