<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Myss.Api.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyssApi\MyssApi.csproj" />
  </ItemGroup>

  <!--
    The shared validation vectors are the contract between this suite and the
    TypeScript suite in MyssWebclient. Linked rather than copied so there is
    exactly one file; if this path breaks, fix the path - do not duplicate it.
  -->
  <ItemGroup>
    <Content Include="..\..\Shared\validation\validation-vectors.json"
             Link="validation-vectors.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The error message catalogue is the contract between the compiled fallback
    (Data/ErrorMessageDefaults.cs) and the Strapi seed in MyssContent. Linked
    for the same reason as the vectors above.
  -->
  <ItemGroup>
    <Content Include="..\..\Shared\validation\error-messages.json"
             Link="error-messages.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The bus pass form specs as Strapi seeds them, every version. Linked so the
    validator and the bus pass rules are tested against the forms citizens are
    actually served, not only against hand-written stand-ins.
  -->
  <ItemGroup>
    <Content Include="..\MyssContent\src\lib\bus-pass-specs\*.json"
             Link="bus-pass-specs\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    The bus pass request sample is the contract between this API's middleware
    provider and IcmApi.Host. Linked for the same reason as the vectors above.
  -->
  <ItemGroup>
    <Content Include="..\..\Shared\contracts\bus-pass-application.sample.json"
             Link="bus-pass-application.sample.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>