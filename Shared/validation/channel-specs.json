      ] },
      "resolved": {
        "client": { "components": [
          { "type": "textfield", "key": "firstName" }
        ] },
        "worker-override": { "components": [
          { "type": "textfield", "key": "firstName" },
          { "type": "textarea", "key": "workerNote", "properties": {} }
        ] }
      }
