        { "type": "textfield", "key": "spouseName", "conditional": { "show": true, "when": "hasSpouse", "eq": "yes" } }
      ] },
      "problems": [
        "\"spouseName\" depends on \"hasSpouse\", which is hidden for the worker-override channel."
