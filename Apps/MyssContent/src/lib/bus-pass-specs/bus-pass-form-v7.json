{
    "display": "form",
    "components": [
        {
            "key": "busPassTitle",
            "html": "<h1>BC Bus Pass Program - Online Request for Service</h1>",
            "type": "content"
        },
        {
            "key": "privacyCallout",
            "type": "bcgovCallout",
            "label": "Privacy notice",
            "variant": "lightGrey",
            "input": false,
            "components": [
                {
                    "key": "privacyNotice",
                    "html": "<p>The personal information requested on this form is collected under the authority of and will be used for the purpose of administering the Employment and Assistance Act and the Employment and Assistance for Persons with Disabilities Act. The collection, use, and disclosure of personal information is subject to the provisions of the Freedom of Information and Protection of Privacy Act. Questions regarding the collection, use, and disclosure of personal information can be directed to an Employment and Assistance Worker of the British Columbia Bus Pass Program by email: visit <a href=\"https://www2.gov.bc.ca/gov/content/family-social-supports/income-assistance/on-assistance/bus-pass\" target=\"_blank\" rel=\"noopener noreferrer\">www.gov.bc.ca/buspassprogram</a>, by phone: <a href=\"tel:18668660800\">1-866-866-0800</a>, or by mail: PO Box 9985, Stn Prov Govt, Victoria BC V8W 9R6.</p>",
                    "type": "content"
                }
            ]
        },
        {
            "key": "serviceRequestHeading",
            "html": "<h2>What type of service would you like to request?</h2>",
            "type": "content"
        },
        {
            "key": "serviceRequestType",
            "type": "bcgovRadio",
            "input": true,
            "label": "Service Request type",
            "values": [
                {
                    "label": "I am an existing client and I would like to update my address.",
                    "value": "addressUpdate"
                },
                {
                    "label": "My bus pass has been lost or stolen. Please mail me a replacement pass application.",
                    "value": "replacement"
                },
                {
                    "label": "I am a new applicant and would like to request a bus pass.",
                    "value": "newApplication"
                }
            ],
            "validate": {
                "required": true,
                "customMessage": "Select the type of service you would like to request"
            }
        },
        {
            "key": "replacementCostAlert",
            "type": "bcgovInlineAlert",
            "label": "Replacement cost",
            "variant": "info",
            "input": false,
            "conditional": {
                "eq": "replacement",
                "show": true,
                "when": "serviceRequestType"
            },
            "components": [
                {
                    "key": "replacementCostNote",
                    "html": "<p><strong>Note:</strong> You will be billed $10 if this is your first replacement pass, $20 if this is your second replacement pass, and $50 for each additional replacement pass during your annual eligibility period.</p>",
                    "type": "content"
                }
            ]
        },
        {
            "key": "acknowledgedPassCancellation",
            "type": "checkbox",
            "input": true,
            "label": "I acknowledge that my lost/stolen bus pass will be cancelled before a replacement application is mailed to me. Bus passes cannot be reactivated if found.",
            "validate": {
                "required": true,
                "customMessage": "Acknowledgement is required"
            },
            "conditional": {
                "eq": "replacement",
                "show": true,
                "when": "serviceRequestType"
            },
            "properties": {
                "myssGroupLabel": "Acknowledgement"
            }
        },
        {
            "key": "newApplicantEligibilityAlert",
            "type": "bcgovInlineAlert",
            "label": "Eligibility criteria",
            "variant": "info",
            "alertTitle": "To be eligible for the BC Bus Pass Program, the applicant must meet one of the following criteria:",
            "input": false,
            "conditional": {
                "eq": "newApplication",
                "show": true,
                "when": "serviceRequestType"
            },
            "components": [
                {
                    "key": "newApplicantEligibilityInfo",
                    "html": "<ul><li>Receiving Federal Guaranteed Income Supplement (GIS), or the Federal Allowance, or the Allowance for the Survivor;</li><li>60–64 years of age and receiving Income Assistance from the Province of British Columbia;</li><li>Over 65 years of age and would qualify for GIS but does not meet the Canadian 10 year residency requirement;</li><li>18–64 years of age, living on a First Nations reserve and receiving disability assistance from the band office; or</li><li>60–64 years of age, living on a First Nations reserve and receiving assistance from the band office.</li></ul><p>For full eligibility and program information, please click on the link below:<br><a href=\"http://www2.gov.bc.ca/gov/content/transportation/passenger-travel/buses-taxis-limos/bus-pass/seniors\" target=\"_blank\" rel=\"noopener noreferrer\">http://www2.gov.bc.ca/gov/content/transportation/passenger-travel/buses-taxis-limos/bus-pass/seniors</a></p>",
                    "type": "content"
                }
            ]
        },
        {
            "key": "eligibilityAcknowledged",
            "type": "checkbox",
            "label": "I have read the BC Bus Pass Program eligibility criteria.",
            "validate": {
                "required": true,
                "customMessage": "Acknowledgement is required"
            },
            "conditional": {
                "eq": "newApplication",
                "show": true,
                "when": "serviceRequestType"
            },
            "properties": {
                "myssGroupLabel": "Acknowledgement"
            }
        },
        {
            "key": "eligibilityCategory",
            "type": "radio",
            "label": "Eligibility category",
            "values": [
                {
                    "label": "I am over 65 years old and immigrated to Canada within the last 10 years or have a 10 year residency extension.",
                    "value": "over65"
                },
                {
                    "label": "I am living on a First Nations reserve and receive assistance from the band office. (Indigenous Services Canada applicants)",
                    "value": "firstNations"
                },
                {
                    "label": "Neither of the above apply to me.",
                    "value": "neither"
                }
            ],
            "validate": {
                "required": true
            },
            "conditional": {
                "eq": "newApplication",
                "show": true,
                "when": "serviceRequestType"
            },
            "errors": {
                "required": "A selection is required"
            }
        },
        {
            "key": "firstNationsDocumentationAlert",
            "type": "bcgovInlineAlert",
            "label": "Band office documentation",
            "variant": "info",
            "input": false,
            "conditional": {
                "eq": "firstNations",
                "show": true,
                "when": "eligibilityCategory"
            },
            "components": [
                {
                    "key": "firstNationsDocumentationNote",
                    "html": "<p><strong>Note:</strong> The BC Bus Pass Program will be contacting you to request additional documentation to be completed by your band office. If you have any questions about the status of your application, please contact your band office.</p>",
                    "type": "content"
                }
            ]
        },
        {
            "key": "personalInformationHeading",
            "html": "<h2>Tell us about yourself</h2>",
            "type": "content"
        },
        {
            "key": "sinAccountNumberNote",
            "html": "<p>Note: You must provide a BC Bus Pass Program account number or Social Insurance Number to submit a request for service.</p>",
            "type": "content"
        },
        {
            "key": "socialInsuranceNumber",
            "type": "textfield",
            "input": true,
            "label": "Social Insurance Number (SIN)",
            "validate": {
                "required": true
            },
            "properties": {
                "myssValidator": "sin"
            }
        },
        {
            "key": "busPassAccountNumber",
            "type": "textfield",
            "input": true,
            "label": "Bus pass account number",
            "validate": {
                "pattern": "^[0-9]{9}$",
                "required": false,
                "customMessage": "Bus pass account number must be 9 digits"
            },
            "inputMask": "999999999"
        },
        {
            "key": "lastName",
            "type": "textfield",
            "input": true,
            "label": "Last name",
            "validate": {
                "pattern": "^[A-Za-z][A-Za-z' -]*$",
                "required": true,
                "minLength": 2,
                "customMessage": "Invalid character(s) in last name"
            }
        },
        {
            "key": "firstName",
            "type": "textfield",
            "input": true,
            "label": "First name",
            "validate": {
                "pattern": "^[A-Za-z][A-Za-z' -]*$",
                "required": true,
                "minLength": 2,
                "customMessage": "Invalid character(s) in first name"
            }
        },
        {
            "key": "dateOfBirth",
            "type": "datetime",
            "label": "Date of birth",
            "input": true,
            "format": "yyyy-MM-dd",
            "enableDate": true,
            "enableTime": false,
            "validate": {
                "required": true
            },
            "errors": {
                "required": "A date of birth is required"
            }
        },
        {
            "key": "phoneNumber",
            "type": "textfield",
            "input": true,
            "label": "Phone number",
            "validate": {
                "required": true
            },
            "inputMask": "(999) 999-9999",
            "properties": {
                "myssValidator": "phone"
            }
        },
        {
            "key": "phoneType",
            "type": "radio",
            "input": true,
            "label": "Phone type",
            "values": [
                {
                    "label": "Home",
                    "value": "home"
                },
                {
                    "label": "Work",
                    "value": "work"
                },
                {
                    "label": "Cell",
                    "value": "cell"
                }
            ],
            "validate": {
                "required": false
            }
        },
        {
            "key": "leaveMessagePrompt",
            "html": "<p class=\"myss-question-label\">If you don't answer the phone, can we leave a message for you?</p>",
            "type": "content"
        },
        {
            "key": "leaveMessage",
            "type": "checkbox",
            "label": "Yes, please leave messages"
        },
        {
            "key": "email",
            "type": "email",
            "input": true,
            "label": "Email",
            "validate": {
                "required": false
            }
        },
        {
            "key": "emailVerification",
            "type": "email",
            "input": true,
            "label": "Email verification",
            "validate": {
                "required": false
            },
            "properties": {
                "myssMatches": "email"
            },
            "errors": {
                "matches": "The two email addresses do not match"
            }
        },
        {
            "key": "preferredCommunication",
            "data": {
                "values": [
                    {
                        "label": "Phone",
                        "value": "phone"
                    },
                    {
                        "label": "Email",
                        "value": "email"
                    }
                ]
            },
            "type": "select",
            "input": true,
            "label": "Preferred method of communication",
            "validate": {
                "required": true
            },
            "placeholder": "- Select -"
        },
        {
            "key": "addressInformationHeading",
            "html": "<h2>Enter your address information</h2>",
            "type": "content"
        },
        {
            "key": "residentialAddressHeading",
            "html": "<h3>Residential address</h3>",
            "type": "content"
        },
        {
            "key": "streetAddress1",
            "type": "bcgovAddressAutocomplete",
            "input": true,
            "label": "Street address line 1",
            "validate": {
                "required": true
            },
            "addressFields": {
                "line2": "streetAddress2",
                "city": "city",
                "province": "province",
                "postalCode": "postalCode"
            }
        },
        {
            "key": "streetAddress2",
            "type": "textfield",
            "input": true,
            "label": "Street address line 2"
        },
        {
            "key": "city",
            "type": "textfield",
            "input": true,
            "label": "City",
            "validate": {
                "required": true
            }
        },
        {
            "key": "province",
            "type": "textfield",
            "input": true,
            "label": "Province",
            "validate": {
                "pattern": "^(BC|British Columbia)$",
                "required": true,
                "customMessage": "An address in BC is required"
            }
        },
        {
            "key": "postalCode",
            "type": "textfield",
            "input": true,
            "label": "Postal code",
            "errors": {
                "pattern": "Invalid postal code format",
                "required": "A postal code is required"
            },
            "validate": {
                "pattern": "^[A-Za-z][0-9][A-Za-z] ?[0-9][A-Za-z][0-9]$",
                "required": true
            },
            "validateOn": "blur",
            "properties": {
                "myssValidator": "postalCode"
            }
        },
        {
            "key": "mailingAddressDifferent",
            "type": "radio",
            "label": "Is your residential address different from your mailing address?",
            "values": [
                {
                    "label": "No",
                    "value": "no"
                },
                {
                    "label": "Yes",
                    "value": "yes"
                }
            ]
        },
        {
            "key": "mailingAddressHeading",
            "html": "<h3>Mailing address</h3>",
            "type": "content",
            "conditional": {
                "eq": "yes",
                "show": true,
                "when": "mailingAddressDifferent"
            }
        },
        {
            "key": "mailingStreetAddress1",
            "type": "bcgovAddressAutocomplete",
            "input": true,
            "label": "Street address line 1",
            "validate": {
                "required": true
            },
            "conditional": {
                "eq": "yes",
                "show": true,
                "when": "mailingAddressDifferent"
            },
            "addressFields": {
                "line2": "mailingStreetAddress2",
                "city": "mailingCity",
                "province": "mailingProvince",
                "postalCode": "mailingPostalCode"
            },
            "errors": {
                "required": "An address is required"
            }
        },
        {
            "key": "mailingStreetAddress2",
            "type": "textfield",
            "input": true,
            "label": "Street address line 2",
            "conditional": {
                "eq": "yes",
                "show": true,
                "when": "mailingAddressDifferent"
            }
        },
        {
            "key": "mailingCity",
            "type": "textfield",
            "input": true,
            "label": "City",
            "validate": {
                "required": true
            },
            "conditional": {
                "eq": "yes",
                "show": true,
                "when": "mailingAddressDifferent"
            },
            "errors": {
                "required": "A city is required"
            }
        },
        {
            "key": "mailingProvince",
            "type": "textfield",
            "input": true,
            "label": "Province",
            "validate": {
                "pattern": "^(BC|British Columbia)$",
                "required": true,
                "customMessage": "An address in BC is required"
            },
            "conditional": {
                "eq": "yes",
                "show": true,
                "when": "mailingAddressDifferent"
            },
            "errors": {
                "required": "A province is required"
            }
        },
        {
            "key": "mailingPostalCode",
            "type": "textfield",
            "input": true,
            "label": "Postal code",
            "errors": {
                "pattern": "Invalid postal code format",
                "required": "A postal code is required"
            },
            "validate": {
                "pattern": "^[A-Za-z][0-9][A-Za-z] ?[0-9][A-Za-z][0-9]$",
                "required": true
            },
            "validateOn": "blur",
            "conditional": {
                "eq": "yes",
                "show": true,
                "when": "mailingAddressDifferent"
            },
            "properties": {
                "myssValidator": "postalCode"
            }
        },
        {
            "key": "submit",
            "type": "button",
            "input": true,
            "label": "Submit",
            "action": "submit"
        }
    ]
}
