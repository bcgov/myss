# Base URL of the MySS API. Used by:
#   - Vite at dev/build time  (src/constants.ts local-dev fallback)
#   - openapi-ts client generation  (npm run generate:schema)
VITE_MYSS_API_URL=http://localhost:5000

# OIDC (Option 1: SPA Auth Code + PKCE). Local vite-dev fallback for
# src/constants.ts; in deployed environments these are injected at container
# start via entrypoint.sh -> window.APP_CONFIG instead.
VITE_OIDC_AUTHORITY=https://dev.loginproxy.gov.bc.ca/auth/realms/standard
VITE_OIDC_CLIENT_ID=sdpr-my-ss-6498
