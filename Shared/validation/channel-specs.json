  ],
  "resolveCases": [
    {
      "name": "the SIN: required for a client, optional for a worker",
      "spec": { "components": [
        { "type": "textfield", "key": "sin", "label": "Please provide your SIN", "validate": { "required": true },
          "properties": { "myssValidator": "sin", "myssChannels": { "worker-override": { "required": false } } } }
      ] },
      "resolved": {
        "client": { "components": [
          { "type": "textfield", "key": "sin", "label": "Please provide your SIN", "validate": { "required": true },
            "properties": { "myssValidator": "sin" } }
        ] },
        "worker-override": { "components": [
          { "type": "textfield", "key": "sin", "label": "Please provide your SIN", "validate": { "required": false },
            "properties": { "myssValidator": "sin" } }
        ] }
      }
    },
    {
      "name": "a field shown to a worker only",
