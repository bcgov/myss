{
    "name": "@myss/formio",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./errorCatalogue": "./src/errorCatalogue.ts",
        "./phone": "./src/phone.ts",
        "./Callout.module.css": "./src/Callout.module.css"
    },
    "scripts": {
        "build": "tsc -b",
        "lint": "eslint .",
