      ]
    },
    {
      "name": "a repeat section hidden while its count question stays shown is accepted",
      "spec": { "components": [
        { "type": "number", "key": "childCount" },
        { "type": "bcgovRepeatSection", "key": "children",
          "properties": { "myssRepeatCount": "childCount", "myssChannels": { "worker-override": { "show": false } } },
          "components": [ { "type": "textfield", "key": "childName" } ] }
      ] },
      "problems": []
