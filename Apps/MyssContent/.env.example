HOST=0.0.0.0
PORT=1337

# App secrets. The placeholders work for local development; generate real
# values (openssl rand -base64 16) for anything shared.
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Local compose Postgres (compose.yaml overrides DATABASE_HOST to "postgres"
# inside the container network; localhost is for running Strapi on the host).
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi-local-dev
DATABASE_SSL=false
